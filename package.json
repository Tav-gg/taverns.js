{
  "name": "taverns.js",
  "version": "0.4.1",
  "description": "SDK for building Tavern bots for the Taverns platform",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "tsc && tsc --noEmit --strict --target ES2020 --module commonjs --types node test/member-join-types.ts && node --test test/voice.test.js test/security.test.js test/retry.test.js test/dm.test.js test/api.test.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "taverns",
    "bot",
    "sdk",
    "api",
    "tav",
    "voice",
    "audio"
  ],
  "license": "Apache-2.0",
  "author": "Tav <https://github.com/Tav-gg>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Tav-gg/taverns.js.git"
  },
  "homepage": "https://github.com/Tav-gg/taverns.js#readme",
  "bugs": {
    "url": "https://github.com/Tav-gg/taverns.js/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "dependencies": {
    "@types/node": ">=18",
    "ws": "^8.21.0"
  },
  "peerDependencies": {
    "@livekit/rtc-node": ">=1.1.0 <2",
    "ffmpeg-static": ">=5"
  },
  "peerDependenciesMeta": {
    "@livekit/rtc-node": {
      "optional": true
    },
    "ffmpeg-static": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/ws": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
